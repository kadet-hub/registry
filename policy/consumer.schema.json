{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer policy .kapitan-sandbox.yaml (CON-1, CON-2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["index_serial", "hosts"],
  "properties": {
    "index_serial": {"type": "integer", "minimum": 0},
    "inventory_backend": {"enum": ["reclass", "reclass-rs", "omegaconf"]},
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oci": {"$ref": "#/$defs/hosts"},
        "helm": {"$ref": "#/$defs/hosts"},
        "git": {"$ref": "#/$defs/hosts"},
        "https": {"$ref": "#/$defs/hosts"}
      }
    },
    "binaries": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]* [a-z][a-z0-9-]*$"}
    },
    "output_capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
      }
    }
  },
  "$defs": {
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$", "maxLength": 253}
    }
  }
}
