{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace entry generators/<name>.yaml (GI-9, QA-5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "owners"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "tag", "sha"],
      "properties": {
        "repo": {"type": "string", "pattern": "^https://(github|gitlab)\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\\.git$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "not": {"pattern": "(^|/)\\.\\.(/|$)"}, "maxLength": 200},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9._-]*?v?[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 100},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "owners": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "path", "sha256"],
        "properties": {
          "rule": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "yanked": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "additionalProperties": {"type": "string", "maxLength": 500}
    }
  }
}
