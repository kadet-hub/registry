#!/usr/bin/env bash
# gate-selftest: run the static checks and the sandbox compile over every
# sample, and the recipe checks over every recipe sample in recipes/, the
# chart and compile (REC-7, REC-8) once its static checks pass and the
# renders proof on kind (REC-9) once those pass. A recipe sample holds one
# recipe directory and the root LICENSE.
# pass-* must pass; fail-* must fail; both must report the line in
# their expect file, which fail-* need. Samples that cannot live in the
# repository are generated here.
#
# Usage: tests/selftest
# Needs GH_TOKEN for the recipe samples (REC-6), and kind, kubectl and uv
# (.github/actions/setup-kind) for REC-9.
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
cp -R -- "$root/tests/samples/." "$work/"

# Copy pass-plain under a new name and record the expected finding.
derive() {
  cp -R -- "$work/pass-plain" "$work/$1"
  sed -i "s|pass-plain|$1|g" "$work/$1/kapitan-generator.yaml" "$work/$1/tests/consumer/inventory/targets/minimal.yml"
  printf '%s\n' "$2" >"$work/$1/expect"
}
key=AKIA$(python3 -c 'import secrets, string; print("".join(secrets.choice(string.ascii_uppercase + "234567") for _ in range(16)))')
derive fail-token "gitleaks: aws-access-token: settings.yml"
printf 'aws_access_key_id: %s\n' "$key" >"$work/fail-token/settings.yml"
derive fail-token-allowed "gitleaks: aws-access-token: keys.py"
printf 'KEY = "%s"  # gitleaks:allow\n' "$key" >"$work/fail-token-allowed/keys.py"
derive fail-eicar "clamav: eicar.txt"
printf '%s%s' 'X5O!P%@AP[4\PZX54(P^)7CC)7}$' 'EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*' >"$work/fail-eicar/eicar.txt"
derive fail-case-collision "collides with"
touch "$work/fail-case-collision/README.md" "$work/fail-case-collision/Readme.md"
derive fail-symlink "tree: symlink passwd"
ln -s /etc/passwd "$work/fail-symlink/passwd"
derive fail-gitattributes "tree: banned file .gitattributes"
printf '* export-subst\n' >"$work/fail-gitattributes/.gitattributes"
derive fail-executable "tree: executable run.sh"
printf '#!/bin/sh\n' >"$work/fail-executable/run.sh"
chmod +x "$work/fail-executable/run.sh"
derive fail-ruff-undefined-name "ruff: helper.py:1:5: F821"
printf 'x = undefined_name  # noqa: F821\n' >"$work/fail-ruff-undefined-name/helper.py"
derive fail-no-minimal "QA-4: the fixture project has no minimal target"
mv -- "$work/fail-no-minimal/tests/consumer/inventory/targets/minimal.yml" "$work/fail-no-minimal/tests/consumer/inventory/targets/main.yml"
derive fail-chart-sha "SEC-8: chart podinfo 6.9.2 has sha256"
cp -R -- "$work/pass-declared-chart/." "$work/fail-chart-sha/"
sed -i 's/pass-declared-chart/fail-chart-sha/; s/sha256: a/sha256: b/' "$work/fail-chart-sha/kapitan-generator.yaml" "$work/fail-chart-sha/tests/consumer/inventory/targets/minimal.yml"
derive fail-tag-without-evidence "QA-6: tag terraform: no *.tf.json or *.tf file in the compiled output"
yq -i '.tags = ["terraform"]' "$work/fail-tag-without-evidence/kapitan-generator.yaml"
derive fail-schema-invalid "QA-7: compiled/minimal/out/config.yaml: ConfigMap data/a: 1 is not of type 'string'"
yq -i '.schemas = "schemas"' "$work/fail-schema-invalid/kapitan-generator.yaml"
sed -i 's/{"kind": "ConfigMap", "data": {"a": "b"}}/{"apiVersion": "v1", "kind": "ConfigMap", "data": {"a": 1}}/' "$work/fail-schema-invalid/__init__.py"
mkdir -p "$work/fail-schema-invalid/schemas/core"
printf '{"type": "object", "properties": {"data": {"type": "object", "additionalProperties": {"type": "string"}}}}\n' >"$work/fail-schema-invalid/schemas/core/configmap_v1.json"
printf 'core:\n  software: Kubernetes\n  version: "1.35"\n  source: https://github.com/yannh/kubernetes-json-schema\n' >"$work/fail-schema-invalid/schemas/sources.yaml"
derive fail-service-without-ports 'QA-10: compiled/minimal/out/config.yaml: Service web: Service "web" is invalid: spec.ports: Required value'
sed -i 's/{"kind": "ConfigMap", "data": {"a": "b"}}/{"apiVersion": "v1", "kind": "Service", "metadata": {"name": "web"}, "spec": {"selector": {"app": "web"}}}/' "$work/fail-service-without-ports/__init__.py"
derive fail-cr-cel 'QA-11: compiled/minimal/out/config.yaml: HelmRelease web: HelmRelease.helm.toolkit.fluxcd.io "web" is invalid: spec: Invalid value: either chart or chartRef must be set'
yq -i '.schemas = "schemas"' "$work/fail-cr-cel/kapitan-generator.yaml"
sed -i 's|{"kind": "ConfigMap", "data": {"a": "b"}}|{"apiVersion": "helm.toolkit.fluxcd.io/v2", "kind": "HelmRelease", "metadata": {"name": "web"}, "spec": {"chart": {"spec": {"chart": "podinfo"}}, "chartRef": {"kind": "OCIRepository", "name": "podinfo"}}}|' "$work/fail-cr-cel/__init__.py"
mkdir -p "$work/fail-cr-cel/schemas/helm.toolkit.fluxcd.io/crds"
printf 'helm.toolkit.fluxcd.io:\n  software: Flux helm-controller\n  version: 1.6.5\n  source: https://github.com/fluxcd/helm-controller/tree/v1.6.5/config/crd/bases\n  license: Apache-2.0\n' >"$work/fail-cr-cel/schemas/sources.yaml"
cat >"$work/fail-cr-cel/schemas/helm.toolkit.fluxcd.io/crds/helmreleases.yaml" <<'EOF'
# Test fixture: the HelmRelease CRD of Flux helm-controller v1.6.5
# (config/crd/bases/helm.toolkit.fluxcd.io_helmreleases.yaml, Apache-2.0),
# reduced to spec.chart, spec.chartRef and their CEL rule.
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: helmreleases.helm.toolkit.fluxcd.io
spec:
  group: helm.toolkit.fluxcd.io
  names:
    kind: HelmRelease
    listKind: HelmReleaseList
    plural: helmreleases
    singular: helmrelease
  scope: Namespaced
  versions:
  - name: v2
    served: true
    storage: true
    schema:
      openAPIV3Schema:
        type: object
        properties:
          spec:
            type: object
            properties:
              chart:
                type: object
                x-kubernetes-preserve-unknown-fields: true
              chartRef:
                type: object
                x-kubernetes-preserve-unknown-fields: true
            x-kubernetes-validations:
            - message: either chart or chartRef must be set
              rule: (has(self.chart) && !has(self.chartRef)) || (!has(self.chart)
                && has(self.chartRef))
EOF
derive fail-cache-lazy-inventory "CMP-5: output differs with --cache on reclass:"
sed -i 's/import BaseObj$/import BaseObj, inventory/; s/{"a": "b"}/{"a": inventory(lazy=True).parameters.optional or "b"}/' "$work/fail-cache-lazy-inventory/__init__.py"
derive fail-big-file-eval "semgrep: dynamic-code: big.py"
python3 -c 'print("x = 1\n" * 166_700 + "eval(\"1\")")' >"$work/fail-big-file-eval/big.py"

# Copy the recipe sample pass-recipe under a new name and record the expected finding.
derive_recipe() {
  cp -R -- "$work/recipes/pass-recipe" "$work/recipes/$1"
  printf '%s\n' "$2" >"$work/recipes/$1/expect"
}
derive_recipe fail-recipe-python "REC-4: vendor/x.py: the shipped tree holds no Python file"
: >"$work/recipes/fail-recipe-python/demo/vendor/x.py"
derive_recipe fail-recipe-vendor-class "REC-4: vendor/x.yml: YAML below vendor/ that no copy entry names would be a class file"
printf 'parameters: {}\n' >"$work/recipes/fail-recipe-vendor-class/demo/vendor/x.yml"
yq -i '.classes += [".vendor.x"]' "$work/recipes/fail-recipe-vendor-class/demo/init.yml"
derive_recipe fail-recipe-no-license "REC-15: vendor/demo.crds.yaml is vendored by a copy entry and has no demo.crds.yaml.LICENSE next to it"
rm -- "$work/recipes/fail-recipe-no-license/demo/vendor/demo.crds.yaml.LICENSE"
derive_recipe fail-recipe-token "gitleaks: aws-access-token: tests/values.yaml"
printf 'aws_access_key_id: %s\n' "$key" >>"$work/recipes/fail-recipe-token/demo/tests/values.yaml"
derive_recipe fail-recipe-oc-env "REC-5: init.yml: uses the resolver oc.env (RCP-17)"
sed -i 's/version: 1.0.0/version: ${oc.env:HOME}/' "$work/recipes/fail-recipe-oc-env/demo/init.yml"
derive_recipe fail-recipe-include "REC-5: init.yml: class recipes.other.vendor.x is neither"
yq -i '.classes += ["recipes.other.vendor.x"]' "$work/recipes/fail-recipe-include/demo/init.yml"
zeros=sha256:$(printf '0%.0s' {1..64})
derive_recipe fail-recipe-unlisted-digest "REC-6: CON-2: ghcr.io/kadet-hub/kubernetes:1.9.0@$zeros: the index does not list this digest for kubernetes"
sed -i "s/@sha256:987694d4[0-9a-f]*/@$zeros/" "$work/recipes/fail-recipe-unlisted-digest/demo/init.yml"
derive_recipe fail-recipe-yanked "REC-6: CON-2: calico-resources 1.0.0 is yanked"
yq -i '.parameters.kapitan.dependencies += [{"type": "oci", "output_path": "lib/calico-resources",
  "source": "ghcr.io/kadet-hub/calico-resources:1.0.0@sha256:b02a55f91b631f43c358974f7a872c0d05726c57bf65b68959585b22cf4c992f"}]' \
  "$work/recipes/fail-recipe-yanked/demo/init.yml"
podinfo=oci://ghcr.io/stefanprodan/charts/podinfo:6.9.2@sha256:971fef0d04d5b3d03d035701dad59411ea0f60e28d16190f02469ddfe5587588
derive_recipe fail-recipe-chart-version "is version 6.9.2, the README names 6.9.1"
sed -i "s|^Source: .*|Source: \`${podinfo/:6.9.2@/:6.9.1@}\`|" "$work/recipes/fail-recipe-chart-version/demo/README.md"
derive_recipe fail-recipe-manifest-digest "REC-7: cluster-operator.yml of rabbitmq/cluster-operator release v2.23.1 has sha256:"
sed -i "s|^Source: .*|Source: \`https://github.com/rabbitmq/cluster-operator/releases/download/v2.23.1/cluster-operator.yml@$zeros\`|" \
  "$work/recipes/fail-recipe-manifest-digest/demo/README.md"
derive_recipe fail-recipe-unpinned-image "REC-8: Deployment/demo: image docker.io/library/busybox:1.37.0 is not pinned by digest (RCP-6)"
yq -i '.parameters.components.demo.image = "docker.io/library/busybox:1.37.0"' "$work/recipes/fail-recipe-unpinned-image/demo/tests/target.yml"
derive_recipe fail-recipe-object-diff "only in the chart: Deployment.apps/demo/demo-podinfo"
sed -i "s|^Source: .*|Source: \`$podinfo\`|" "$work/recipes/fail-recipe-object-diff/demo/README.md"
# A custom resource, which QA-10 skips, with a name the API server rejects in the dry run.
derive_recipe fail-recipe-dry-run 'metadata.name: Invalid value: "demo_invalid"'
crds=$work/recipes/fail-recipe-dry-run/demo/vendor/demo.crds.yaml
printf -- '---\napiVersion: example.com/v1\nkind: Demo\nmetadata:\n  name: demo_invalid\n' >>"$crds"
sed -i "s/c90177b685ae8ba316d05f756492d579f6d599ba2b6c25a9659c9dc1bdca0b7c/$(sha256sum <"$crds" | cut -d' ' -f1)/" \
  "$work/recipes/fail-recipe-dry-run/demo/init.yml"

failed=0
for dir in "$work"/*/ "$work"/recipes/*/; do
  name=$(basename -- "$dir")
  [[ $name != recipes ]] || continue
  report=$work/$name.txt
  got=pass
  if [[ $dir == "$work"/recipes/* ]]; then
    dirs=("$dir"*/)
    recipe=$(basename -- "${dirs[0]}")
    mkdir -- "$work/$name.static" "$work/$name.proof"
    if "$root/gate/recipe-static" "$dir" "$recipe" "$work/$name.static" >"$report" 2>&1 \
      && "$root/gate/recipe-compile" "$dir" "$recipe" "$work/$name.static" "$work/$name.proof" >>"$report" 2>&1; then
      "$root/gate/recipe-renders" "$dir" "$recipe" "$work/$name.proof" >>"$report" 2>&1 || got=fail
    else
      got=fail
    fi
  elif "$root/gate/fetch-charts" "$dir" "$work/$name.charts" >"$report" 2>&1; then
    "$root/scan/static-scan" "$dir" >>"$report" 2>&1 || got=fail
    if [[ -n $(ls -A -- "$work/$name.charts") ]]; then "$root/scan/static-scan" "$work/$name.charts" >>"$report" 2>&1 || got=fail; fi
    "$root/sandbox/gate-compile" "$dir" "$name" "$work/$name.charts" >>"$report" 2>&1 || got=fail
  else
    got=fail
  fi
  want=${name%%-*}
  echo "::group::$name: want $want, got $got"
  cat -- "$report"
  echo "::endgroup::"
  if [[ $got != "$want" ]]; then
    echo "::error::$name: want $want, got $got"
    failed=1
  elif [[ $want == fail || -f $dir/expect ]] && ! grep -qF -- "$(cat -- "$dir/expect")" "$report"; then
    echo "::error::$name: ${got}ed without the expected line: $(cat -- "$dir/expect")"
    failed=1
  fi
done

# CON-1a: the mode without gVisor, run as this non-root user, cleans up after itself.
echo "::group::pass-plain with SANDBOX_TRACE=0"
SANDBOX_TRACE=0 "$root/sandbox/gate-compile" "$work/pass-plain" pass-plain || {
  echo "::error::pass-plain failed with SANDBOX_TRACE=0"
  failed=1
}
echo "::endgroup::"
exit "$failed"
