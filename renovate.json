{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1"],
  "automerge": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "customManagers": [
    {
      "description": "REG-7: bump tag and commit SHA of marketplace entries",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(generators|recipes)/[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "repo: (?<packageName>https://\\S+)\\n\\s+path: \\S+\\n\\s+tag: (?<currentValue>\\S+)\\n\\s+sha: (?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^(?<compatibility>.*?)v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "REG-7: tool versions marked with a renovate comment; release-asset and image pins carry their checksum along",
      "customType": "regex",
      "managerFilePatterns": [
        "/^sandbox/Dockerfile$/",
        "/^\\.github/workflows/[^/]+\\.yml$/",
        "/^\\.github/actions/[^/]+/action\\.yml$/",
        "/^sandbox/gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+)\\n\\s*(?:ARG )?[A-Z_]+[=:] ?\"?(?<currentValue>[^\"\\s]+)\"?",
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\n\\s*(?:ARG )?[A-Z_]+[=:] ?\"?(?<currentValue>[^\"\\s]+)\"?\\n\\s*(?:ARG )?[A-Z_]+_SHA(?:256|512)[=:] ?\"?(?<currentDigest>[0-9a-f]{64,128})\"?",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+[=:] ?\"?\\S+?:(?<currentValue>[^@\"\\s:]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"?"
      ]
    },
    {
      "description": "ClamAV image digest in the static scan",
      "customType": "regex",
      "managerFilePatterns": [
        "/^scan/static-scan$/"
      ],
      "matchStrings": [
        "(?<depName>clamav/clamav)@(?<currentDigest>sha256:[0-9a-f]{64}) # (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "check.py and the trace policy name the Python 3.13 interpreter",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.13-slim$/"
    },
    {
      "description": "GI-14: base-builder-python runs Python 3.11, and atheris 3.1.0 has no cp311 wheel",
      "matchPackageNames": [
        "atheris"
      ],
      "allowedVersions": "<3.1"
    },
    {
      "description": "Kapitan 0.36.3's omegaconf backend needs ListMergeMode, which later pre-releases removed",
      "matchPackageNames": [
        "omegaconf"
      ],
      "allowedVersions": "/^2\\.4\\.0\\.dev4$/"
    },
    {
      "description": "Runners stay on ubuntu-24.04: the scanner locks are for its Python and actionlint 1.7.12 does not know newer labels",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "gVisor tags are release-YYYYMMDD.N; the download path uses YYYYMMDD",
      "matchDepNames": [
        "google/gvisor"
      ],
      "extractVersion": "^release-(?<version>\\d+)\\.\\d+$",
      "versioning": "loose"
    },
    {
      "description": "Every entry bump is its own pull request for review (DEC-3)",
      "matchFileNames": [
        "generators/*.yaml",
        "recipes/*.yaml"
      ],
      "groupName": null,
      "commitMessageTopic": "generator {{depName}}"
    },
    {
      "description": "REG-7: git tags carry no release timestamp",
      "matchDatasources": [
        "git-tags"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "REG-7: registries other than Docker Hub report no release timestamp",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^[^/]*[.:][^/]*//",
        "!/^(docker\\.io|index\\.docker\\.io)//"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "gitlabci": {
    "managerFilePatterns": [
      "/^sandbox/gitlab-ci\\.yml$/"
    ]
  }
}
