#!/usr/bin/env bash
# Compile a generator's fixture project in the gVisor sandbox and judge the
# trace and the output (SEC-9 to SEC-12, CMP-1, CMP-2).
#
# Usage: gate-compile <generator dir> <name>
# Needs: what sandbox/run needs, and yq. Prints findings; exits 1 on any.
set -euo pipefail

gen=$1
name=$2
here=$(cd -- "$(dirname -- "$0")" && pwd)
root=$(cd -- "$here/.." && pwd)

manifest=$gen/kapitan-generator.yaml
fixtures=$(yq -r '.fixtures' -- "$manifest")
if [[ ! $fixtures =~ ^[A-Za-z0-9._/-]+$ || $fixtures == *..* || $fixtures == /* ]]; then
  echo "manifest: fixtures must be a relative path inside the generator: $fixtures"
  exit 1
fi
allow=()
while IFS= read -r binary; do
  allow+=(--allow "${binary// /-}")
done < <(yq -r '.binaries // [] | .[]' -- "$manifest")
output=()
while IFS= read -r capability; do
  output+=(--allow "$capability")
done < <(yq -r '.output_capabilities // [] | .[]' -- "$manifest")
while IFS= read -r glob; do
  output+=(--unparsed "$glob")
done < <(yq -r '.unparsed_outputs // [] | .[]' -- "$manifest")

work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

# Project: the fixture tree with the generator at lib/<name>, no .kapitan.
mkdir -p -- "$work/project/lib"
cp -RP -- "$gen/$fixtures/." "$work/project/"
cp -RP -- "$gen" "$work/project/lib/$name"
rm -f -- "$work/project/.kapitan"

backends=()
while IFS= read -r backend; do
  backends+=("$backend")
done < <(yq -r '.inventory_backends // ["reclass"] | .[]' -- "$manifest")
targets=()
while IFS= read -r target; do
  targets+=("$target")
done < <(find "$work/project/inventory/targets" -type f \( -name '*.yml' -o -name '*.yaml' \) -printf '%f\n' 2>/dev/null | sed -E 's/\.ya?ml$//' | sort -u)

status=0
# compile <out dir> [run options]: compile into <out dir> on $backend.
compile() {
  local out=$1
  shift
  mkdir -- "$out"
  "$here/run" "${allow[@]}" "$@" --result "$out" "$work/project" compile --output-path /out --inventory-backend "$backend" || status=1
}

# CMP-1, with SEC-11 in run and SEC-12 below, on every backend.
for backend in "${backends[@]}"; do
  echo "### backend $backend"
  compile "$work/out-$backend"
  for target in "${targets[@]}"; do
    if ! find "$work/out-$backend/compiled/$target" -type f -print -quit 2>/dev/null | grep -q .; then
      echo "CMP-1: target $target produced no file on $backend"
      status=1
    fi
  done
  # SEC-12 in the sandbox image without network; the output is data only.
  docker run --rm --network none --read-only --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$root,dst=/base,readonly" \
    --mount "type=bind,src=$work/out-$backend,dst=/out,readonly" \
    "${SANDBOX_IMAGE:-kadet-hub/sandbox}" \
    python -I /base/sandbox/output_check.py --out /out --policy /base/policy/output "${output[@]}" || status=1
done

# CMP-2: the same output with CI set, on the first backend.
backend=${backends[0]}
echo "### backend $backend with CI set"
compile "$work/out-ci" --env CI=true --env GITHUB_ACTIONS=true --env GITLAB_CI=true
if ! (cd -- "$work" && diff -r -- "out-$backend" out-ci) >"$work/ci.diff"; then
  echo "CMP-2: output differs with CI set:"
  head -n 20 -- "$work/ci.diff"
  status=1
fi
exit "$status"
