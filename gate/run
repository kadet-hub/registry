#!/usr/bin/env bash
# The gate for one pull request: Gate integrity, Registration, then the
# static checks and the sandbox compile. Runs from the main checkout and
# never executes pull request content (GI-1).
#
# Needs: GH_TOKEN (contents and pull-requests read), REPO, PR, HEAD_SHA,
# GITHUB_EVENT_PATH, and the tools of .github/actions/setup-gate. Prints a
# report in "## <section>" blocks; copies entry.json to $GATE_OUT if set.
# For a recipe that passes every check before REC-9, writes the input of
# gate/recipe-renders as the tar $PROOF_OUT if set.
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
image=${SANDBOX_IMAGE:-kadet-hub/sandbox}
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
cp -- "$GITHUB_EVENT_PATH" "$work/event.json"

# Parse and judge in the sandbox image without network; the checkout of main
# is the only policy source.
check() {
  docker run --rm --network none --read-only --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$root,dst=/base,readonly" \
    --mount "type=bind,src=$work,dst=/work" \
    "$image" python -I /base/gate/check_entry.py "$@" --event /work/event.json --policy /base/policy
}

echo "## Registration"
gh api --paginate "repos/$REPO/pulls/$PR/files" --jq '.[] | {filename, status, previous_filename}' >"$work/files.jsonl"
check files --files /work/files.jsonl --out /work/path
path=$(cat -- "$work/path")
if [[ -z $path ]]; then
  echo "no entry changed"
  exit 0
fi

raw() { gh api -H "Accept: application/vnd.github.raw" "repos/$REPO/contents/$1?ref=$HEAD_SHA"; }
if [[ $path == removed:* ]]; then
  raw policy/reserved-names.txt >"$work/reserved.txt" || : >"$work/reserved.txt"
  check entry --path-file /work/path --reserved /work/reserved.txt --base /base --out /work/entry.json
  exit 0
fi
# $path matched ^(generators|recipes)/[a-z][a-z0-9-]{1,38}\.yaml$ in the files step.
raw "$path" >"$work/head.yaml"
token=$GH_TOKEN  # only gate/recipe-static gets it back, for gh attestation verify (REC-6)
unset GH_TOKEN

check entry --path-file /work/path --head /work/head.yaml --base /base --out /work/entry.json
if [[ -n ${GATE_OUT:-} ]]; then cp -- "$work/entry.json" "$GATE_OUT/entry.json"; fi
field() { jq -r --arg k "$1" '.[$k]' -- "$work/entry.json"; }
name=$(field name) src_repo=$(field repo) src_path=$(field path) tag=$(field tag) sha=$(field sha)

status=0
# REG-1: the tag resolves to the pinned commit.
export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
gitc=(git -c protocol.allow=never -c protocol.https.allow=always)
resolved=$("${gitc[@]}" ls-remote -- "$src_repo" "refs/tags/$tag" "refs/tags/$tag^{}" | awk '{print $1}' | tail -n 1)
if [[ $resolved != "$sha" ]]; then
  echo "REG-1: tag $tag resolves to ${resolved:-nothing}, entry pins $sha"
  status=1
fi

echo "## Source"
# Fetch the pinned commit and write source.sha:source.path without checkout.
"${gitc[@]}" init -q --bare -- "$work/src.git"
"${gitc[@]}" --git-dir="$work/src.git" fetch -q --depth=1 --no-tags -- "$src_repo" "$sha"
# REC-4 to REC-8 and REC-15 to REC-17 on the recipe at <rev>, written below <dir>.
recipe_checks() {
  local rev=$1 dir=$2 rc=0 others=()
  mkdir -- "$dir" "$dir/static" "$dir/proof"
  # Every recipe of the commit without tests/, as check lint resolves includes and Requires (REC-4, REC-5).
  python3 "$root/gate/fetch_tree.py" --git-dir "$work/src.git" --rev "$rev" --recipe "$name" --out "$dir/recipes" || rc=1
  "${gitc[@]}" --git-dir="$work/src.git" cat-file blob "$rev:LICENSE" >"$dir/recipes/LICENSE" 2>/dev/null \
    || rm -f -- "$dir/recipes/LICENSE"
  echo "## Static checks"
  GH_TOKEN=$token "$root/gate/recipe-static" "$dir/recipes" "$name" "$dir/static" || rc=1
  echo "## Chart and sandbox compile"
  # REC-4, REC-8, REC-17: each included and required recipe compiles from its own tests/target.yml.
  if [[ -f $dir/static/recipe.json ]]; then mapfile -t others < <(jq -r '.included[], (.required | keys[])' -- "$dir/static/recipe.json"); fi
  if ((${#others[@]})); then
    python3 "$root/gate/fetch_tree.py" --git-dir "$work/src.git" --rev "$rev" --targets "${others[@]}" --out "$dir/recipes" || rc=1
  fi
  "$root/gate/recipe-compile" "$dir/recipes" "$name" "$dir/static" "$dir/proof" || rc=1
  return "$rc"
}
if [[ $path == recipes/* ]]; then
  recipe_checks "$sha" "$work/new" | tee "$work/new.txt" || status=1
  # REC-9 runs in the renders job of gate.yml, on what this job fetched and compiled.
  if ((status)); then
    echo "REC-9: not run, a check before it failed"
  elif [[ -n ${PROOF_OUT:-} ]]; then
    printf '%s\n' "$name" >"$work/new/name"
    tar -cf "$PROOF_OUT" -C "$work/new" name recipes proof
  fi
  # REC-10: on a bump, the approved version through the same checks, shown and not judged, as SEC-13 does.
  previous=$(field previous_sha)
  if [[ $previous != null && $previous != "$sha" ]]; then
    echo "## Output diff"
    if ! "${gitc[@]}" --git-dir="$work/src.git" fetch -q --depth=1 --no-tags -- "$src_repo" "$previous"; then
      echo "REC-10: the approved version $previous could not be fetched"
    else
      if ! recipe_checks "$previous" "$work/previous" >"$work/previous.txt" 2>&1; then
        echo "REC-10: the approved version's checks reported, not judged:"
        grep -vE '^(#|SEC-12: )' -- "$work/previous.txt" | head -n 20 || true
      fi
      if [[ -f $work/previous/static/recipe.json && -f $work/new/static/recipe.json && -d $work/previous/proof/out && -d $work/new/proof/out ]]; then
        python3 -I "$root/gate/output_diff.py" --old "$work/previous/proof/out" --new "$work/new/proof/out" \
          --compile-log "$work/new.txt" --full "${GATE_OUT:-$work}/output.diff" \
          --recipe "$work/previous/static/recipe.json" "$work/new/static/recipe.json" --old-compile-log "$work/previous.txt"
      else
        echo "REC-10: no output diff, the compile of a version did not complete"
      fi
    fi
  fi
  echo "REC-11: the release publishes no recipe yet (REC-11 to REC-13), so no recipe entry passes the gate"
  exit 1
fi
gen=$work/generator
python3 "$root/gate/fetch_tree.py" --git-dir "$work/src.git" --rev "$sha" --path "$src_path" --out "$gen" || status=1

# QA-1: LICENSE at the repository root, read from the fetched commit.
if [[ $src_path != . ]]; then
  "${gitc[@]}" --git-dir="$work/src.git" cat-file blob "$sha:LICENSE" >"$work/root-license" 2>/dev/null \
    || rm -f -- "$work/root-license"
fi
check manifest --entry /work/entry.json --manifest "/work/generator/kapitan-generator.yaml" \
  --root-license /work/root-license || exit 1

echo "## Charts"
"$root/gate/fetch-charts" "$gen" "$work/charts" || exit 1
echo "## Static checks"
rc=0
"$root/scan/static-scan" "$gen" >"$work/static.txt" 2>&1 || rc=$?
jq '.exceptions' -- "$work/entry.json" >"$work/exceptions.json"
python3 -I "$root/scan/exceptions.py" --tree "$gen" --exceptions "$work/exceptions.json" \
  --report "$work/static.txt" --rc "$rc" || status=1
if [[ -n $(ls -A -- "$work/charts") ]]; then "$root/scan/static-scan" "$work/charts" || status=1; fi
echo "## Sandbox compile"
mkdir -- "$work/out-new"
OUTPUT_DIR=$work/out-new "$root/sandbox/gate-compile" "$gen" "$name" "$work/charts" | tee "$work/compile.txt" || status=1

# SEC-13: the approved version's output, compiled the same way, as the base.
echo "## Output diff"
previous=$(field previous_sha)
if [[ $previous == null ]]; then
  echo "SEC-13: new entry, no approved version to compare with"
elif ! "${gitc[@]}" --git-dir="$work/src.git" fetch -q --depth=1 --no-tags -- "$src_repo" "$previous" \
  || ! python3 "$root/gate/fetch_tree.py" --git-dir "$work/src.git" --rev "$previous" --path "$src_path" --out "$work/previous" >/dev/null \
  || ! "$root/gate/fetch-charts" "$work/previous" "$work/previous-charts" >/dev/null; then
  echo "SEC-13: the approved version $previous could not be fetched"
else
  mkdir -- "$work/out-previous"
  if ! COMPILE_ONLY=1 OUTPUT_DIR=$work/out-previous "$root/sandbox/gate-compile" "$work/previous" "$name" \
    "$work/previous-charts" >"$work/previous.txt" 2>&1; then
    echo "SEC-13: the approved version's compile reported, not judged:"
    head -n 20 -- "$work/previous.txt"
  fi
  # QA-7: did the bump move its schemas along with the code?
  docker run --rm --network none --read-only --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$root,dst=/base,readonly" \
    --mount "type=bind,src=$work/previous,dst=/old,readonly" \
    --mount "type=bind,src=$gen,dst=/new,readonly" \
    "$image" python -I /base/gate/schema_diff.py --old /old --new /new || true
  python3 -I "$root/gate/output_diff.py" --old "$work/out-previous" --new "$work/out-new" \
    --compile-log "$work/compile.txt" --full "${GATE_OUT:-$work}/output.diff"
fi
exit "$status"
