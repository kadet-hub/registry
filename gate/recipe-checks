#!/usr/bin/env bash
# REC-4 to REC-8 and REC-15 to REC-17 on one version of a recipe, for the
# gate job, the release build job and the output diff (REC-10, REC-12).
#
# Usage: recipe-checks <git dir> <rev> <name> <dir>
# <git dir> holds the fetched commit <rev>. Writes below the new <dir> the
# recipes of <rev> as gate/fetch_tree.py writes them (recipes/), what
# gate/recipe-static wrote (static/) and what gate/recipe-compile wrote
# (proof/). Needs: GH_TOKEN, which only gate/recipe-static gets, and what
# those scripts need. Prints the report; exits 1 on any finding.
set -euo pipefail
git_dir=$1 rev=$2 name=$3 dir=$4
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
token=${GH_TOKEN:-}
unset GH_TOKEN
rc=0 others=()
mkdir -- "$dir" "$dir/static" "$dir/proof"
# Every recipe of the commit without tests/, as check lint resolves includes and Requires (REC-4, REC-5).
python3 "$root/gate/fetch_tree.py" --git-dir "$git_dir" --rev "$rev" --recipe "$name" --out "$dir/recipes" || rc=1
git --git-dir="$git_dir" cat-file blob "$rev:LICENSE" >"$dir/recipes/LICENSE" 2>/dev/null \
  || rm -f -- "$dir/recipes/LICENSE"
echo "## Static checks"
GH_TOKEN=$token "$root/gate/recipe-static" "$dir/recipes" "$name" "$dir/static" || rc=1
echo "## Chart and sandbox compile"
# REC-4, REC-8, REC-17: each included and required recipe compiles from its own tests/target.yml.
if [[ -f $dir/static/recipe.json ]]; then mapfile -t others < <(jq -r '.included[], (.required | keys[])' -- "$dir/static/recipe.json"); fi
if ((${#others[@]})); then
  python3 "$root/gate/fetch_tree.py" --git-dir "$git_dir" --rev "$rev" --targets "${others[@]}" --out "$dir/recipes" || rc=1
fi
"$root/gate/recipe-compile" "$dir/recipes" "$name" "$dir/static" "$dir/proof" || rc=1
exit "$rc"
