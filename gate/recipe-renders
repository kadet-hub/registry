#!/usr/bin/env bash
# The recipe's renders proof on kind (REC-9).
#
# Usage: recipe-renders <recipes dir> <name> <proof dir>
# <recipes dir> and <name> as for gate/recipe-compile, <proof dir> what it
# wrote there. Runs the pinned check of kadet-hub/recipes in $RECIPES_CHECK
# (.github/actions/setup-check) with uv, kind, kubectl and Docker
# (.github/actions/setup-kind) on the host: check reads the files as data
# and applies the objects to its kind clusters. Prints check's report and
# the findings; exits 1 on any.
set -euo pipefail

recipes=$(cd -- "$1" && pwd)
name=$2
proof=$(cd -- "$3" && pwd)
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
check=$(cd -- "${RECIPES_CHECK:-$root/gate/.check}" && pwd)
err=$(mktemp)
trap 'rm -f -- "$err"' EXIT

# A chart or a release manifest has its render, a compose source or a designed recipe none (RCP-34).
rendered=()
if [[ -f $proof/rendered.yaml ]]; then rendered=(--rendered "$proof/rendered.yaml"); fi
status=0
uv run --quiet --locked --project "$check" "$check/check.py" "$recipes/$name" --level renders \
  --compiled "$proof/out" "${rendered[@]}" 2>"$err" || status=$?
if ((status == 0)); then
  cat -- "$err"
  exit 0
fi
# check exits 1 when the proof fails, after the report lines that name each
# failure, and 2 with "error: <message>" when a step such as a dry run fails.
if ((status == 1)); then
  cat -- "$err"
  echo "REC-9: check $name --level renders failed"
elif [[ -s $err ]]; then
  sed -n '1s/^\(error: \)\{0,1\}/REC-9: /;1,40p' -- "$err"
else
  echo "REC-9: check $name --level renders exited $status"
fi
exit 1
