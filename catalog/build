#!/usr/bin/env bash
# Build the catalog site from an index (CAT-1 to CAT-14).
#
# Usage: build <index.json> <out dir>
# Needs: OWNER (registry owner), hugo, python3, jq, oras, gh. GH_TOKEN raises
# the API rate limit; CATALOG_OFFLINE=1 skips the API and the registry and
# reads artifact layers from $CATALOG_ARTIFACTS/<name>.tar and SBOMs from
# $CATALOG_SBOMS/<name>/<version>.spdx.json instead.
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
index=$(realpath -- "$1")
mkdir -p -- "$2"
out=$(realpath -- "$2")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

cp -R -- "$here/site/." "$work/"
mkdir -- "$work/data"
offline=()
artifacts=${CATALOG_ARTIFACTS:-$work/artifacts}
sboms=${CATALOG_SBOMS:-$work/sboms}
if [[ ${CATALOG_OFFLINE:-} == 1 ]]; then
  offline=(--offline)
else
  # CAT-7: the layer of each generator's latest version that is not yanked, by digest.
  mkdir -p -- "$artifacts"
  while read -r name digest; do
    ref=ghcr.io/$OWNER/$name
    if layer=$(oras manifest fetch -- "$ref@$digest" | jq -er 'select(.artifactType == "application/vnd.kadet-hub.generator.v1") | .layers[0].digest') \
      && oras blob fetch --output "$artifacts/$name.tar" -- "$ref@$layer"; then
      continue
    fi
    echo "::warning::$name: artifact $digest not fetched; the page shows no README"
  done < <(jq -r '.generators | to_entries[] | .key as $n
    | [.value | to_entries[] | select(.value.yanked == null)] | sort_by(.key | split(".") | map(tonumber)) | last
    | select(. != null) | "\($n) \(.value.digest)"' -- "$index")
  # CAT-14: each listed version's SBOM, from its verified attestation (PUB-8).
  identity=https://github.com/$OWNER/registry/.github/workflows/release.yml@refs/heads/main
  while read -r name version digest; do
    mkdir -p -- "$sboms/$name"
    gh attestation verify "oci://ghcr.io/$OWNER/$name@$digest" --owner "$OWNER" --cert-identity "$identity" \
      --predicate-type https://spdx.dev/Document/v2.3 --format json --jq '.[0].verificationResult.statement.predicate' \
      >"$sboms/$name/$version.spdx.json" 2>/dev/null || rm -f -- "$sboms/$name/$version.spdx.json"
  done < <(jq -r '.generators | to_entries[] | .key as $n | .value | to_entries[]
    | select(.value.yanked == null) | "\($n) \(.key) \(.value.digest)"' -- "$index")
fi
if [[ -d $sboms ]]; then
  mkdir -p -- "$work/static/generators"
  cp -R -- "$sboms/." "$work/static/generators/"
fi
cp -- "$here/../policy/tags.yaml" "$work/data/tags.yaml"
python3 -I "$here/view.py" --index "$index" --owner "$OWNER" "${offline[@]}" --artifacts "$artifacts" --sboms "$sboms" --out "$work/data/catalog.json"
hugo --quiet --source "$work" --destination "$out" --baseURL "${CATALOG_URL:-https://kadet-hub.org/}"
