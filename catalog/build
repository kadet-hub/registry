#!/usr/bin/env bash
# Build the catalog site from an index (CAT-1 to CAT-33).
#
# Usage: build <index.json> <out dir>
# Needs: OWNER (registry owner), hugo, python3, jq, oras, gh. GH_TOKEN raises
# the API rate limit; CATALOG_OFFLINE=1 skips the API and the registry and
# reads artifact layers from $CATALOG_ARTIFACTS/<name>.tar, SBOMs from
# $CATALOG_SBOMS/<name>/<version>.spdx.json, output diffs from
# $CATALOG_DIFFS/<name>/<version>.output.diff and transparency log indexes
# from $CATALOG_REKOR (JSON {name: {version: index}}) and open generator
# requests from $CATALOG_WANTED (CAT-31) and pull requests with their gate
# comments from $CATALOG_GATE (CAT-33) and the recipe classes from
# $CATALOG_RECIPES/inventory/classes (CAT-37a) instead. Online, the
# previous build's published catalog.json supplies README, CHANGELOG sections, log index and
# SBOM of every unchanged digest, and its output diffs are kept when their
# sha256 matches the index, so each version is pulled from the registry
# once (CAT-23); CATALOG_PAGES receives the package pages.
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
index=$(realpath -- "$1")
mkdir -p -- "$2"
out=$(realpath -- "$2")
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

cp -R -- "$here/site/." "$work/"
mkdir -- "$work/data"
offline=()
artifacts=${CATALOG_ARTIFACTS:-$work/artifacts}
sboms=${CATALOG_SBOMS:-$work/sboms}
diffs=${CATALOG_DIFFS:-$work/diffs}
rekor=${CATALOG_REKOR:-$work/rekor.json}
discussions=${CATALOG_DISCUSSIONS:-$work/discussions.json}
wanted=${CATALOG_WANTED:-$work/wanted.json}
gate=${CATALOG_GATE:-$work/gate.json}
pages=${CATALOG_PAGES:-$work/pages}
recipes=$work/recipes
site=${CATALOG_URL:-https://kadet-hub.org/}
if [[ ${CATALOG_OFFLINE:-} == 1 ]]; then
  offline=(--offline)
  recipes=$CATALOG_RECIPES
else
  # CAT-37a: the recipe classes from kadet-hub/examples@main; one that is not fetched fails the build.
  fetch() {
    mkdir -p -- "$(dirname -- "$recipes/inventory/classes/$1")"
    curl -fsSL --max-time 20 "https://raw.githubusercontent.com/$OWNER/examples/main/recipes/inventory/classes/$1" -o "$recipes/inventory/classes/$1" \
      || { echo "::error::recipes: $1 not fetched from $OWNER/examples"; exit 1; }
  }
  fetch generators.yml
  for page in "$here"/site/content/recipes/*.md; do fetch "recipes/$(basename -- "$page" .md).yml"; done
  for g in $(sed -nE 's|^ *output_path: lib/([a-z0-9-]+)$|\1|p' -- "$recipes/inventory/classes/generators.yml"); do fetch "recipes/lib/$g.yml"; done
  # CAT-7: the layer of each generator's latest version that is not yanked, by digest.
  # CAT-23: what the previous build published, to reuse for unchanged digests.
  previous=$work/previous.json
  curl -fsSL --max-time 20 "${site}catalog.json" -o "$previous" 2>/dev/null && jq -e .generators "$previous" >/dev/null 2>&1 \
    || echo '{"generators": []}' >"$previous"
  mkdir -p -- "$artifacts"
  while read -r name digest; do
    ref=ghcr.io/$OWNER/$name
    if jq -e --arg n "$name" --arg d "$digest" '.generators[] | select(.name == $n and .latest.digest == $d and .readme != null and .changelog != null)' "$previous" >/dev/null; then
      continue  # view.py takes the README and the CHANGELOG sections (CAT-36b) from the previous build
    fi
    if layer=$(oras manifest fetch -- "$ref@$digest" | jq -er 'select(.artifactType == "application/vnd.kadet-hub.generator.v1") | .layers[0].digest') \
      && oras blob fetch --output "$artifacts/$name.tar" -- "$ref@$layer"; then
      continue
    fi
    echo "::warning::$name: artifact $digest not fetched; the page shows no README"
  done < <(jq -r '.generators | to_entries[] | .key as $n
    | [.value | to_entries[] | select(.value.yanked == null)] | sort_by(.key | split(".") | map(tonumber)) | last
    | select(. != null) | "\($n) \(.value.digest)"' -- "$index")
  # CAT-14: each listed version's SBOM, from its verified attestation (PUB-8);
  # CAT-17: every version's Rekor log index, from its verified provenance
  # attestation; a yanked version keeps it while its artifact exists.
  identity=https://github.com/$OWNER/registry/.github/workflows/release.yml@refs/heads/main
  sha() { sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1; }
  echo '{}' >"$rekor"
  while read -r name version digest yanked; do
    old=$(jq -c --arg n "$name" --arg d "$digest" 'first(.generators[] | select(.name == $n) | .versions[] | select(.digest == $d)) // {}' "$previous")
    logindex=$(jq -r '.rekor // empty' <<<"$old")
    if [[ ! $logindex =~ ^[0-9]+$ ]]; then
      logindex=$(gh attestation verify "oci://ghcr.io/$OWNER/$name@$digest" --owner "$OWNER" --cert-identity "$identity" \
        --format json --jq '.[0].attestation.bundle.verificationMaterial.tlogEntries[0].logIndex' 2>/dev/null) || logindex=
    fi
    if [[ $logindex =~ ^[0-9]+$ ]]; then
      jq --arg n "$name" --arg v "$version" --arg i "$logindex" '.[$n][$v] = $i' -- "$rekor" >"$work/rekor.tmp" && mv -- "$work/rekor.tmp" "$rekor"
    fi
    [[ $yanked == listed ]] || continue
    # CAT-27: the output diff from its verified attestation (PUB-9), kept only
    # when its sha256 is the index record's.
    want=$(jq -r --arg n "$name" --arg v "$version" '.generators[$n][$v].output_diff.sha256 // empty' -- "$index")
    if [[ -n $want ]]; then
      mkdir -p -- "$diffs/$name"
      diff=$diffs/$name/$version.output.diff
      curl -fsSL --max-time 20 "${site}generators/$name/$version.output.diff" -o "$diff" 2>/dev/null || :
      if [[ $(sha "$diff") != "$want" ]]; then
        gh attestation verify "oci://ghcr.io/$OWNER/$name@$digest" --owner "$OWNER" --cert-identity "$identity" \
          --predicate-type https://kadet-hub.org/output-diff/v1 --format json --jq '.[0].verificationResult.statement.predicate' \
          2>/dev/null | jq -j .diff >"$diff" 2>/dev/null || :
      fi
      [[ $(sha "$diff") == "$want" ]] || rm -f -- "$diff"
    fi
    mkdir -p -- "$sboms/$name"
    sbom=$sboms/$name/$version.spdx.json
    if [[ $(jq -r '.sbom' <<<"$old") == true ]] && curl -fsSL --max-time 20 "${site}generators/$name/$version.spdx.json" -o "$sbom" 2>/dev/null \
      && jq -e '.spdxVersion' "$sbom" >/dev/null 2>&1; then
      continue
    fi
    gh attestation verify "oci://ghcr.io/$OWNER/$name@$digest" --owner "$OWNER" --cert-identity "$identity" \
      --predicate-type https://spdx.dev/Document/v2.3 --format json --jq '.[0].verificationResult.statement.predicate' \
      >"$sbom" 2>/dev/null || rm -f -- "$sbom"
  done < <(jq -r '.generators | to_entries[] | .key as $n | .value | to_entries[]
    | "\($n) \(.key) \(.value.digest) \(if .value.yanked == null then "listed" else "yanked" end)"' -- "$index")
  # CAT-23: the public package page is the only source of the pull count.
  mkdir -p -- "$pages"
  for name in $(jq -r '.generators | keys[]' -- "$index"); do
    curl -fsSL --max-time 20 "https://github.com/orgs/$OWNER/packages/container/package/$name" -o "$pages/$name.html" \
      || { rm -f -- "$pages/$name.html"; echo "::warning::$name: package page not read; pulls count as 0"; }
  done
  # CAT-20: one discussion per listed generator and its 👍 count.
  "$here/discussions" "$index" >"$discussions" || echo "::warning::discussions not read; the catalog shows no 👍 counts"
  # CAT-31: the open generator requests and their 👍 count; no body.
  gh api --paginate "repos/$OWNER/registry/issues?labels=generator-request&state=open&per_page=100" \
    --jq '.[] | select(.pull_request == null) | {number, title, up: .reactions["+1"], created: .created_at, updated: .updated_at}' \
    | jq -s . >"$wanted" || { rm -f -- "$wanted"; echo "::warning::generator requests not read; the wanted page says so"; }
  # CAT-33: every pull request's changed paths and comments with their edit history; view.py keeps counts only.
  gh api graphql --paginate -f o="$OWNER" -f query='query($o: String!, $endCursor: String) { repository(owner: $o, name: "registry") {
    pullRequests(first: 20, after: $endCursor) { pageInfo { hasNextPage endCursor } nodes { number files(first: 100) { nodes { path } }
      comments(first: 100) { nodes { author { login } body userContentEdits(first: 100) { nodes { diff } } } } } } } }' \
    --jq '.data.repository.pullRequests.nodes[] | {number, files: [.files.nodes[].path],
      comments: [.comments.nodes[] | {author: .author.login, versions: [.body, (.userContentEdits.nodes[].diff // empty)]}]}' \
    | jq -s . >"$gate" || { rm -f -- "$gate"; echo "::warning::gate comments not read; the statistics page says so"; }
fi
for dir in "$sboms" "$diffs"; do
  if [[ -d $dir ]]; then
    mkdir -p -- "$work/static/generators"
    cp -R -- "$dir/." "$work/static/generators/"
  fi
done
cp -- "$here/../policy/tags.yaml" "$work/data/tags.yaml"
mkdir -- "$work/assets/classes"
cp -R -- "$recipes/inventory/classes/." "$work/assets/classes/"
previous_arg=()
if [[ -f ${previous:-} ]]; then previous_arg=(--previous "$previous"); fi
python3 -I "$here/view.py" --index "$index" --owner "$OWNER" "${offline[@]}" --artifacts "$artifacts" --sboms "$sboms" --rekor "$rekor" --discussions "$discussions" --pages "$pages" "${previous_arg[@]}" --diffs "$diffs" --wanted "$wanted" --gate "$gate" --out "$work/data/catalog.json"
cp -- "$work/data/catalog.json" "$work/static/catalog.json"  # CAT-23: the next build reuses it
hugo --quiet --source "$work" --destination "$out" --baseURL "${CATALOG_URL:-https://kadet-hub.org/}"
