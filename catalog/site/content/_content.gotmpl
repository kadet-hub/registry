{{/* One landing page per tag at /tags/<tag>/ (CAT-18); text from policy/tags.yaml. */}}
{{ range $id, $t := site.Data.tags }}
  {{ $.AddPage (dict "kind" "page" "path" (printf "tags/%s" $id) "title" (printf "%s generators" $t.title) "layout" "tag" "params" (dict "tag" $id) "description" (printf "Kapitan generators for %s: %s" $t.title $t.means)) }}
{{ end }}
{{/* One landing page per Kubernetes kind at /kinds/<group>/<kind>/ (CAT-29); view.py reads the kinds from the SBOMs. */}}
{{ range $group, $kinds := site.Data.catalog.kinds }}
  {{ range $kind, $_ := $kinds }}
    {{ $.AddPage (dict "kind" "page" "path" (printf "kinds/%s/%s" $group $kind) "title" (printf "%s (%s)" $kind $group) "layout" "kind" "params" (dict "group" $group "kindname" $kind) "description" (truncate 159 "…" (printf "Kapitan generators on kadet-hub that ship a JSON Schema for %s (%s), gate-checked and attested." $kind $group))) }}
  {{ end }}
{{ end }}
