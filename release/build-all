#!/usr/bin/env bash
# Build job (PUB-1, PUB-7, PUB-9, CMP-4, REC-11, REC-12): fetch every entry's
# source without checkout, validate and build in the sandbox image without
# network, then rerun the static checks and the compile gate for versions not
# yet published and record the run, the krab result, the output diff, the
# kinds of the output and the backends it compiled on in meta.json. For a
# recipe version, rerun the gate's recipe checks and renders proof and record
# what REC-13 lists and the images of REC-12 instead.
#
# Usage: build-all <out dir>
# Needs: the sandbox image $SANDBOX_IMAGE, yq, jq, oras, REGISTRY, what
# scan/static-scan, sandbox/gate-compile, release/scan-record and
# release/output-diff need, the main checkout; for a recipe GH_TOKEN, which
# only gate/recipe-checks gets, and what it and gate/recipe-renders need.
# Writes the artifacts, their output.diff and names.json to <out dir>, a
# recipe's below <out dir>/recipes/.
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
image=${SANDBOX_IMAGE:-kadet-hub/sandbox}
out=$1
token=${GH_TOKEN:-}
unset GH_TOKEN
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
mkdir -p -- "$work/src/recipes" "$work/recipes" "$out"

export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
for f in "$root"/generators/*.yaml; do
  [[ -e $f ]] || continue
  name=$(basename -- "$f" .yaml)
  repo=$(yq -r .source.repo "$f") path=$(yq -r .source.path "$f") sha=$(yq -r .source.sha "$f")
  gitc=(git -c protocol.allow=never -c protocol.https.allow=always --git-dir="$work/$name.git")
  "${gitc[@]}" init -q --bare
  "${gitc[@]}" fetch -q --depth=1 --no-tags -- "$repo" "$sha"
  python3 "$root/gate/fetch_tree.py" --git-dir "$work/$name.git" --rev "$sha" --path "$path" --out "$work/src/$name"
  # PUB-15: the repository root's LICENSE, which build.py ships when the tree has none.
  "${gitc[@]}" cat-file blob "$sha:LICENSE" >"$work/src/$name.LICENSE" 2>/dev/null || rm -f -- "$work/src/$name.LICENSE"
done
# REC-11: a recipe's directories as the gate fetches them (REC-4); build.py ships <name>/ without tests/.
for f in "$root"/recipes/*.yaml; do
  [[ -e $f ]] || continue
  name=$(basename -- "$f" .yaml)
  repo=$(yq -r .source.repo "$f") sha=$(yq -r .source.sha "$f")
  gitc=(git -c protocol.allow=never -c protocol.https.allow=always --git-dir="$work/recipes/$name.git")
  "${gitc[@]}" init -q --bare
  "${gitc[@]}" fetch -q --depth=1 --no-tags -- "$repo" "$sha"
  python3 "$root/gate/fetch_tree.py" --git-dir "$work/recipes/$name.git" --rev "$sha" --recipe "$name" --out "$work/src/recipes/$name"
  "${gitc[@]}" cat-file blob "$sha:LICENSE" >"$work/src/recipes/$name/LICENSE" 2>/dev/null || rm -f -- "$work/src/recipes/$name/LICENSE"
done

docker run --rm --network none --read-only --user "$(id -u):$(id -g)" \
  --mount "type=bind,src=$root,dst=/base,readonly" \
  --mount "type=bind,src=$work/src,dst=/src,readonly" \
  --mount "type=bind,src=$(cd -- "$out" && pwd),dst=/out" \
  "$image" python -I /base/release/build.py --base /base --sources /src --out /out

# shellcheck source=release/common.sh
. "$root/release/common.sh"

# REC-12: the recipe checks of the gate job and the renders proof of its renders job on
# recipes/<name> <version>, then the record of REC-13, with the scan record and the output diff.
build_recipe() {
  local name=$1 version=$2 dir=$work/recipes/$1 dest=$out/recipes/$1 check caps
  check=$(cd -- "${RECIPES_CHECK:-$root/gate/.check}" && pwd)
  echo "## recipe $name $version: checks"
  GH_TOKEN=$token "$root/gate/recipe-checks" "$work/recipes/$name.git" "$(yq -r .source.sha "$root/recipes/$name.yaml")" "$name" "$dir" \
    | tee "$work/compile.txt" || { echo "REC-12: recipe $name $version: the checks failed"; exit 1; }
  # PUB-9: before the renders proof copies the required recipes' output next to the recipe's (REC-10).
  GH_TOKEN=$token "$root/release/output-diff" "recipes/$name" "$dir/proof/out" "$work/compile.txt" "$dest" >"$work/diff.json" \
    || { rm -f -- "$dest/output.diff"; echo '{"base": null, "error": "output diff failed"}' >"$work/diff.json"; }
  echo "PUB-9: recipe $name $version: $(cat -- "$work/diff.json")"
  echo "## recipe $name $version: renders"
  "$root/gate/recipe-renders" "$dir/recipes" "$name" "$dir/proof" || { echo "REC-12: recipe $name $version: the renders proof failed"; exit 1; }
  # REC-13: the Source and Level lines as the pinned check reads them (REC-7), the kinds of the recipe's own output (PUB-10)
  # and the container images it names (REC-12).
  docker run --rm --network none --read-only --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$root,dst=/base,readonly" --mount "type=bind,src=$check,dst=/check,readonly" \
    --mount "type=bind,src=$dir,dst=/recipe,readonly" \
    "$image" python -I -c 'import json, os, sys
sys.path[:0] = ["/check", "/base/sandbox", "/base/release"]
import images, lint, tag_check
source, level = lint.readme_fields("/recipe/recipes/" + sys.argv[1])
out = "/recipe/proof/out/compiled/" + sys.argv[1]
docs = [d for rel in tag_check.files(out) if rel.endswith((".yml", ".yaml", ".json")) for d in tag_check.k8s_documents(os.path.join(out, rel))]
print(json.dumps({"source": source, "level": level, "kinds": tag_check.kinds(out), "images": images.images(docs)}))' \
    "$name" >"$work/fields.json"
  # DEC-23: the capabilities of the SEC-12 matches in the recipe's own output.
  caps=$(sed -nE "s#^SEC-12: ([a-z-]+): compiled/$name/.*#\1#p" -- "$work/compile.txt" | sort -u | jq -cnR '[inputs]')
  "$root/release/scan-record" 0 recipe >"$work/scan.json"
  jq -c -S --slurpfile r "$dir/static/recipe.json" --slurpfile f "$work/fields.json" --slurpfile scan "$work/scan.json" \
    --slurpfile diff "$work/diff.json" --argjson caps "$caps" \
    '$r[0] as $r | $f[0] as $f | ($f.source // ["none", []]) as [$kind, $s]
    | .description = $r.description | .license = $r.license | .level = $f.level
    | .generators = [$r.pins[] | capture("^ghcr\\.io/kadet-hub/(?<name>[^:]+):(?<version>[^@]+)@(?<digest>.+)$")]
    | .includes = [$r.recipes | to_entries[] | select(.value.rule == "REC-16") | {name: .key, version: .value.version, digest: .value.digest}]
    | .output_capabilities = $caps | .kinds = $f.kinds | .images = $f.images | .scan = $scan[0] | .output_diff = $diff[0]
    | if $kind == "chart" then .chart = {repo: $s[0], version: $s[1], digest: $s[2]}
      elif $kind == "http" then .chart = {repo: "\($s[0])/\($s[1])", version: $s[2], digest: $s[3]}
      elif $kind == "manifest" then .manifest = {url: "https://github.com/\($s[0])/releases/download/\($s[1])/\($s[2])", digest: $s[3]}
      else . end' -- "$dest/meta.json" >"$work/meta.json"
  cp -- "$work/meta.json" "$dest/meta.json"
}

while IFS= read -r name; do
  meta=$out/$name/meta.json
  version=$(jq -r .version -- "$meta")
  rc=0; lookup oras resolve -- "$REGISTRY/$name:$version" >/dev/null || rc=$?
  ((rc < 2)) || exit 1
  if ((rc == 0)); then
    echo "$name $version: published, not compiled"
    continue
  fi
  if [[ $name == recipes/* ]]; then
    build_recipe "${name#recipes/}" "$version"
    continue
  fi
  echo "## $name $version: compile gate"
  "$root/gate/fetch-charts" "$work/src/$name" "$work/charts-$name" \
    || { echo "SEC-8: $name $version: the charts do not match"; exit 1; }
  # PUB-7: the static checks with the entry's exceptions (SEC-14), as in gate/run.
  yq -o json '.exceptions // []' "$root/generators/$name.yaml" >"$work/exceptions.json"
  rc=0
  "$root/scan/static-scan" "$work/src/$name" >"$work/static.txt" 2>&1 || rc=$?
  python3 -I "$root/scan/exceptions.py" --tree "$work/src/$name" --exceptions "$work/exceptions.json" \
    --report "$work/static.txt" --rc "$rc" || { echo "PUB-7: $name $version: the static checks failed"; exit 1; }
  if [[ -n $(ls -A -- "$work/charts-$name") ]]; then
    "$root/scan/static-scan" "$work/charts-$name" || { echo "PUB-7: $name $version: the chart scan failed"; exit 1; }
  fi
  mkdir -- "$work/out-$name"
  KRAB_RESULT=$work/krab SCHEMA_RESULT=$work/compatibility.json KINDS_RESULT=$work/kinds.json BACKENDS_RESULT=$work/backends \
    OUTPUT_DIR=$work/out-$name \
    "$root/sandbox/gate-compile" "$work/src/$name" "$name" "$work/charts-$name" | tee "$work/compile.txt" \
    || { echo "CMP-4: $name $version: the compile gate failed"; exit 1; }
  "$root/release/scan-record" "$(jq length -- "$work/exceptions.json")" >"$work/scan.json"
  # PUB-9: never fails the release.
  "$root/release/output-diff" "$name" "$work/out-$name" "$work/compile.txt" "$out/$name" >"$work/diff.json" \
    || { rm -f -- "$out/$name/output.diff"; echo '{"base": null, "error": "output diff failed"}' >"$work/diff.json"; }
  echo "PUB-9: $name $version: $(cat -- "$work/diff.json")"
  jq -c -S --arg krab "$(cat -- "$work/krab")" --slurpfile scan "$work/scan.json" --slurpfile compat "$work/compatibility.json" \
    --slurpfile diff "$work/diff.json" --slurpfile kinds "$work/kinds.json" --argjson backends "$(jq -cnR '[inputs]' -- "$work/backends")" \
    '.krab = $krab | .scan = $scan[0] | .compatibility = $compat[0] | .output_diff = $diff[0] | .kinds = $kinds[0] | .backends = $backends' \
    -- "$meta" >"$work/meta.json"
  cp -- "$work/meta.json" "$meta"
done < <(jq -r '.[]' -- "$out/names.json")
