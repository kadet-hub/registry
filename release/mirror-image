#!/usr/bin/env bash
# Mirror job (PUB-13, PUB-13a): copy the digest an upstream tag points to into
# $REGISTRY/mirror/<name>, tagged by its source commit, without moving a tag,
# and record where its sources are published (DEC-16).
#
# Usage: mirror-image <upstream repository>:<tag> <name> <source repository URL> <source RPM URL>...
# Needs: REGISTRY (ghcr.io/<owner>), oras logged in, jq.
set -euo pipefail
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=release/common.sh
. "$root/release/common.sh"
(($# >= 4)) || { echo "usage: mirror-image <repository>:<tag> <name> <source repository URL> <source RPM URL>..."; exit 2; }
src=$1 dst=$REGISTRY/mirror/$2 repo=$3
shift 3

digest=$(oras resolve -- "$src")
config=$(oras manifest fetch-config -- "${src%:*}@$digest")
commit=$(jq -r '.config.Labels["org.opencontainers.image.revision"] // .config.Labels["multi.GIT_SHA"] // empty' <<<"$config")
tag=${commit:-$(jq -er '.created[0:10] | gsub("-"; "")' <<<"$config")}
[[ $tag =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$ ]] || { echo "PUB-13: $src: no valid tag from its labels: $tag"; exit 1; }

rc=0; current=$(lookup oras resolve -- "$dst:$tag") || rc=$?
((rc < 2)) || exit 1
if ((rc == 0)); then
  [[ $current == "$digest" ]] || { echo "PUB-13: $dst:$tag is $current, $src is now $digest; tag not moved"; exit 1; }
  echo "$dst:$tag: already $digest"
else
  oras cp -- "${src%:*}@$digest" "$dst@$digest" >/dev/null
  oras tag -- "$dst@$digest" "$tag" >/dev/null
  echo "$dst:$tag: pushed $digest"
fi
if [[ -n $commit ]]; then source=$repo/tree/$tag; else source="$repo (tag $tag is the image date, not a commit)"; fi
{
  echo "| \`$src\` | \`$digest\` | \`$dst:$tag\` |"
  echo
  echo "Copied unmodified. Source: $source. Base image source RPMs: $*"
} >>"${GITHUB_STEP_SUMMARY:-/dev/null}"
